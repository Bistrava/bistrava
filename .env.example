# Canonical public URL. Use http://localhost:3000 in local development.
NEXT_PUBLIC_SITE_URL=

# Set false for public staging previews; enable indexing only for the approved release.
# This affects generated robots.txt and response headers and requires a rebuild.
ROBOTS_INDEXING_ENABLED=

# Supabase project URL and browser-safe publishable key from the Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key. Server-only; never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Resend server-only API key. Keep blank until an account is connected.
RESEND_API_KEY=

# Transactional sender and reply-to addresses. Do not use the Bistrava sender
# until mail.bistrava.com has been verified by Resend.
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_INTERNAL_TO=

# LWS admin inbox: kontakt@bistrava.com, mail60.lwspanel.com, IMAP 993 / SMTP 465.
# Enter the Production password directly in Vercel as a server-only Secret.
LWS_MAIL_PASSWORD=

# Salt used to hash request IPs for the lightweight form rate limiter.
RATE_LIMIT_SALT=

# Ordering switch. Use true for the open store; false temporarily disables submissions.
CHECKOUT_ORDERING_ENABLED=false

# Supported pre-payment workflow. A real payment provider still requires explicit approval.
CHECKOUT_MODE=manual_review

# Bank transfer activation: CHECKOUT_MODE=bank_transfer plus the existing ordering switch.
# Receiving account supplied by the business owner; never use sample bank details in production.
BANK_TRANSFER_BENEFICIARY=
BANK_TRANSFER_IBAN=
BANK_TRANSFER_BANK_NAME=
BANK_TRANSFER_BIC=

# Stripe card processing starts only when all three keys are set.
# Without these keys, the visible card option directs customers to bank transfer.
# (plus CHECKOUT_ORDERING_ENABLED=true). Use test keys (sk_test_/pk_test_) until approved.
# The webhook endpoint is <site>/api/stripe/webhook with payment_intent.succeeded,
# payment_intent.payment_failed and payment_intent.canceled. Server-only; enter directly in Render.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional statistics identifiers. Tags wait for current statistics consent.
# GTM containers must contain only approved statistics tags. The Google Ads tag loads only after "Dovoli vse".
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
# Optional: defaults to the "Bistrava - Nakup" label in src/lib/analytics/google-ads.ts.
NEXT_PUBLIC_GOOGLE_ADS_PURCHASE_LABEL=
