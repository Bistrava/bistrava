# Canonical public URL. Use http://localhost:3000 in local development.
NEXT_PUBLIC_SITE_URL=

# Supabase project URL and browser-safe publishable key from the Connect dialog.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase secret key. Server-only; never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Resend server-only API key. Keep blank until an account is connected.
RESEND_API_KEY=

# Transactional sender and reply-to addresses. Do not use the Bistrava sender
# until mail.bistrava.com has been verified by Resend.
EMAIL_FROM=
EMAIL_REPLY_TO=
EMAIL_INTERNAL_TO=

# Salt used to hash request IPs for the lightweight form rate limiter.
RATE_LIMIT_SALT=

# Keep false until selling prices, public stock, delivery and legal terms are approved.
CHECKOUT_ORDERING_ENABLED=false

# Supported pre-payment workflow. A real payment provider still requires explicit approval.
CHECKOUT_MODE=manual_review

# Optional Google measurement identifiers. Consent Mode v2 defaults to denied.
# Prefer GTM for production orchestration; GA4/Ads can be used directly without GTM.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
